# Copie para .env.local e preencha. NUNCA versione valores reais.
# Somente URL pública e publishable key vão ao navegador (protegidas por RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL canônica do app, usada em links de e-mail (não confiamos no header Host).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Não há uso de service_role/secret key no app na Fase 1. Se um dia for necessário,
# defina apenas no ambiente do servidor (Vercel/Supabase), nunca com prefixo NEXT_PUBLIC_.
